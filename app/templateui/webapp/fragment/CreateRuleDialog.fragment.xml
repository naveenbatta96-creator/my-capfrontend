<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="createRuleDialog" title="Add Mapping Rule" contentWidth="500px" draggable="true">
        <content>
            <VBox class="sapUiMediumMargin" width="80%">
                <VBox class="sapUiSmallMarginBottom">
                    <Label text="Rule ID" required="true" />
                    <Input
                        id="ruleIdInput"
                        placeholder="e.g. RULE_GET_CUSTOMER"
                        width="80%"
                        class="sapUiTinyMarginTop"
                    />
                    <Text text="Unique identifier for this rule"
                        class="sapThemeTextDefault sapUiTinyMarginTop" />
                </VBox>

                <VBox class="sapUiSmallMarginBottom">
                    <Label text="Rule Name" required="true" />
                    <Input
                        id="ruleNameInput"
                        placeholder="e.g. Derive Customer"
                        width="80%"
                        class="sapUiTinyMarginTop"
                    />
                    <Text text="Human-readable description of this rule"
                        class="sapThemeTextDefault sapUiTinyMarginTop" />
                </VBox>
            </VBox>
        </content>

        <beginButton>
            <Button text="Add" type="Emphasized" press=".onConfirmCreateRule" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCloseCreateRuleDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>