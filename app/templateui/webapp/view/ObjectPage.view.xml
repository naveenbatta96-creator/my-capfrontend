<mvc:View
    controllerName="com.template.builder.controller.ObjectPage"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns="sap.m"
>
    <Page showHeader="true" showFooter="true">
        <customHeader>
            <f:ShellBar
                title="Lockbox Template Builder"
                showCopilot="false" showSearch="false"
                showNotifications="false" showProductSwitcher="false"
                homeIcon="https://www.sap.com/dam/application/shared/logos/sap-logo-svg.svg"
            />
        </customHeader>

        <content>
            <VBox class="sapUiMediumMargin">
                <Link text="&lt; Back to Templates" press=".onNavBack" class="sapUiTinyMarginBottom" />
                <Title text="{templateName}" level="H2"
                    class="sapUiTinyMarginTop sapUiTinyMarginBottom" />
                <Text
                    text="Map source fields to API fields. Click Auto Map (Standard) to copy rules from the standard template."
                    class="sapUiMediumMarginBottom"
                />

                <!-- Metadata Card -->
                <Panel backgroundDesign="Solid" class="sapUiContentPadding sapUiSmallMarginBottom"
                    width="100%">
                    <content>
                        <HBox justifyContent="SpaceBetween" alignItems="Center" width="100%">
                            <VBox width="25%">
                                <Label text="Template ID" class="sapUiTinyMarginBottom" />
                                <Label
                                    text="{parts: [{path: 'ID'},{path: 'templateType'}], formatter: '.formatTemplateID'}"
                                    design="Bold"
                                />
                            </VBox>
                            <VBox width="25%">
                                <Label text="Template Name" class="sapUiTinyMarginBottom" />
                                <Label text="{templateName}" design="Bold" />
                            </VBox>
                            <VBox width="20%">
                                <Label text="Sheet Mode" class="sapUiTinyMarginBottom" />
                                <ObjectStatus
                                    text="{= ${sheetMode} === 'SINGLE' ? 'Single sheet' : 'Multiple sheets' }"
                                    state="{= ${sheetMode} === 'SINGLE' ? 'Information' : 'Success' }"
                                />
                            </VBox>
                            <VBox width="30%">
                                <Label text="Total Mappings" class="sapUiTinyMarginBottom" />
                                <HBox alignItems="Center" width="100%">
                                    <Text
                                        text="{metaModel>/mappingsCount} / {metaModel>/totalCount} mapped"
                                        class="sapUiTinyMarginEnd"
                                    />
                                    <ProgressIndicator
                                        percentValue="{metaModel>/percentValue}"
                                        showValue="false"
                                        state="Success"
                                        width="140px"
                                    />
                                </HBox>
                            </VBox>
                        </HBox>
                    </content>
                </Panel>

                <!-- Toolbar -->
                <OverflowToolbar class="sapUiMediumMarginTop sapUiTinyMarginBottom">
                    <Button text="Auto Map (Standard)" icon="sap-icon://activate" type="Accept"
                        press=".onAutoMapStandard" class="sapUiTinyMarginEnd" />
                    <Button text="Auto Map (AI)" icon="sap-icon://ai" press=".onAutoMapAI"
                        class="sapUiTinyMarginEnd" />
                    <Button text="Clear All" icon="sap-icon://delete" type="Transparent"
                        press=".onClearAllMappings" class="sapUiTinyMarginEnd" />
                    <ToggleButton
                        text="Unmapped Only"
                        icon="sap-icon://broken-link"
                        pressed="{metaModel>/unmappedFilterPressed}"
                        press=".onToggleUnmappedFilter"
                    />
                    <ToolbarSpacer />
                    <Button text="Add Mapping" icon="sap-icon://add" type="Emphasized"
                        press=".onAddMapping" />
                </OverflowToolbar>

                <!-- Source Fields Table — Level, Source Field, API Field only -->
                <Panel backgroundDesign="Transparent" class="sapUiSmallMarginTop" width="100%">
                    <headerToolbar>
                        <Toolbar>
                            <core:Icon src="sap-icon://table-view" class="sapUiTinyMarginEnd" />
                            <Title text="Source Fields" level="H3" />
                            <Text text="({metaModel>/totalCount} fields)"
                                class="sapUiTinyMarginBegin sapThemeTextDefault" />
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <ScrollContainer height="480px" vertical="true" horizontal="false"
                            width="100%">
                            <Table
                                id="mappingTable"
                                updateFinished="._updateMappingStats"
                                items="{path: 'mappings', parameters: {$expand: 'field'}}"
                                width="100%"
                                sticky="ColumnHeaders"
                                noDataText="No fields added. Click 'Add Mapping' to get started."
                            >
                                <columns>
                                    <Column width="15%">
                                        <Text text="Level" />
                                    </Column>
                                    <Column width="30%">
                                        <Text text="Source Field" />
                                    </Column>
                                    <Column width="55%">
                                        <Text text="API Field" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <!-- LEVEL -->
                                            <ObjectStatus
                                                text="{path: 'field/levelName', formatter: '.formatLevelText'}"
                                                state="{path: 'field/levelName', formatter: '.formatLevelState'}"
                                            />
                                            <!-- SOURCE FIELD -->
                                            <Text text="{field/fieldName}" />
                                            <!-- API FIELD — 31 camelCase keys from corrected CSV -->
                                            <Select
                                                selectedKey="{apiField}"
                                                width="100%"
                                                change=".onMappingPropertyChange"
                                                enabled="{= !${authModel>/isStandardTemplate} || ${authModel>/isAdmin} }"
                                            >
                                                <items>
                                                    <core:Item key="" text="— None —" />
                                                    <!-- HEADER LEVEL -->
                                                    <core:Item key="batchNumber"
                                                        text="Batch Number" />
                                                    <core:Item key="lockboxNumber"
                                                        text="Lockbox Number" />
                                                    <core:Item key="companyCode" text="Company Code" />
                                                    <core:Item key="batchDestination"
                                                        text="Batch Destination" />
                                                    <core:Item key="batchOrigin"
                                                        text="Batch Origin" />
                                                    <core:Item key="depositDate"
                                                        text="Deposit Date" />
                                                    <core:Item key="incomingPaymentFile"
                                                        text="Incoming Payment File" />
                                                    <core:Item
                                                        key="numberOfItems"
                                                        text="Number of Items" />
                                                    <core:Item key="currency" text="Currency" />
                                                    <core:Item key="paymentAmount"
                                                        text="Payment Amount" />
                                                    <!-- PAYMENT LEVEL -->
                                                    <core:Item key="batchItemNumber"
                                                        text="Batch Item Number" />
                                                    <core:Item key="valueDate" text="Value Date" />
                                                    <core:Item key="chequeNumber"
                                                        text="Cheque Number" />
                                                    <core:Item key="partnerBankCountry"
                                                        text="Partner Bank Country" />
                                                    <core:Item key="partnerBankCode"
                                                        text="Partner Bank Code" />
                                                    <core:Item key="partnerBankAccount"
                                                        text="Partner Bank Account" />
                                                    <core:Item key="customer" text="Customer" />
                                                    <core:Item key="memoLine1" text="Memo Line 1" />
                                                    <core:Item key="memoLine" text="Memo Line" />
                                                    <core:Item key="paymentAdviceNumber"
                                                        text="Payment Advice Number" />
                                                    <core:Item key="assignmentReference"
                                                        text="Assignment Reference" />
                                                    <core:Item key="documentItemText"
                                                        text="Document Item Text" />
                                                    <core:Item key="documentReferenceID"
                                                        text="Document Reference ID" />
                                                    <core:Item key="fiscalYear" text="Fiscal Year" />
                                                    <!-- CLEARING LEVEL -->
                                                    <core:Item key="paymentAdviceItem"
                                                        text="Payment Advice Item" />
                                                    <core:Item key="paymentAdviceAccount"
                                                        text="Payment Advice Account" />
                                                    <core:Item key="paymentAdviceAccountType"
                                                        text="Payment Advice Account Type" />
                                                    <core:Item key="paymentReference"
                                                        text="Payment Reference" />
                                                    <core:Item key="netPaymentAmount"
                                                        text="Net Payment Amount" />
                                                    <core:Item key="deductionAmount"
                                                        text="Deduction Amount" />
                                                    <core:Item key="paymentDifferenceReason"
                                                        text="Payment Difference Reason" />
                                                </items>
                                            </Select>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </ScrollContainer>
                    </content>
                </Panel>

                <!-- Mapping Rules Table -->
                <Panel backgroundDesign="Transparent" class="sapUiMediumMarginTop" width="100%">
                    <headerToolbar>
                        <Toolbar>
                            <core:Icon src="sap-icon://list" class="sapUiTinyMarginEnd" />
                            <Title text="Mapping Rules" level="H3" />
                            <Text text="({= ${rulesModel>/rules/length} || 0} rules)"
                                class="sapUiTinyMarginBegin" />
                            <ToolbarSpacer />
                            <Button text="Add Rule" icon="sap-icon://add" type="Transparent"
                                press=".onAddRule" />
                        </Toolbar>
                    </headerToolbar>
                    <content>
                        <ScrollContainer height="300px" vertical="true" horizontal="false"
                            width="100%">
                            <Table
                                id="mappingRulesTable"
                                sticky="ColumnHeaders"
                                items="{rulesModel>/rules}"
                                width="100%"
                                noDataText="No mapping rules. Click 'Add Rule' or use Auto Map."
                            >
                                <columns>
                                    <Column width="10%">
                                        <Text text="Sequence" />
                                    </Column>
                                    <Column width="35%">
                                        <Text text="Rule ID" />
                                    </Column>
                                    <Column width="45%">
                                        <Text text="Rule Name" />
                                    </Column>
                                    <Column width="10%" hAlign="Center">
                                        <Text text="Action" />
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <Text text="{rulesModel>sequence}" />
                                            <Input
                                                value="{rulesModel>ruleId}"
                                                placeholder="e.g. RULE_FETCH_ACCT_DOC"
                                                width="100%"
                                                editable="{= !${authModel>/isStandardTemplate} || ${authModel>/isAdmin} }"
                                            />
                                            <Input
                                                value="{rulesModel>ruleName}"
                                                placeholder="e.g. Fetch Account Document"
                                                width="100%"
                                                editable="{= !${authModel>/isStandardTemplate} || ${authModel>/isAdmin} }"
                                            />
                                            <HBox justifyContent="Center" alignItems="Center"
                                                width="48px">
                                                <Button icon="sap-icon://delete" type="Reject"
                                                    press=".onDeleteRule" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </ScrollContainer>
                    </content>
                </Panel>
            </VBox>
        </content>

        <footer>
            <OverflowToolbar>
                <Button text="Back" icon="sap-icon://back" press=".onNavBack" />
                <ToolbarSpacer />
                <Button text="Preview API Payload" icon="sap-icon://developer-settings"
                    press=".onPreviewAPIPayload" />
                <Button text="Validate Mapping" icon="sap-icon://accept" press=".onValidateMapping" />
                <Button
                    icon="sap-icon://save"
                    type="Emphasized"
                    tooltip="Save Changes"
                    press=".onSaveChanges"
                    visible="{= !${authModel>/isStandardTemplate} || ${authModel>/isAdmin} }"
                />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>