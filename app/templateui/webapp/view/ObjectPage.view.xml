                                    <core:Item key="BankName" text="Bank Name" />
                                    <core:Item key="BankAccountNumber" text="Bank Account Number" />
                                    <core:Item key="CustomerNumber" text="Customer Number" />
                                    <core:Item key="MemoLine1" text="Memo Line 1" />
                                    <core:Item key="MemoRemarks" text="Memo / Remarks" />
                                    <core:Item key="PaymentAdviceNumber" text="Payment Advice Number" />
                                    <core:Item key="AssignmentReference" text="Assignment Reference" />
                                    <core:Item key="ItemText" text="Item Text" />
                                    <core:Item key="ReferenceDocumentID" text="Reference Document ID" />
                                    <core:Item key="ManualTransactionType" text="Manual Transaction Type" />
                                    <core:Item key="AdditionalInformation" text="Additional Information" />
                                    <core:Item key="PaymentAdviceItem" text="Payment Advice Item" />
                                    <core:Item key="CustomerAccount" text="Customer Account" />
                                    <core:Item key="AccountType" text="Account Type" />
                                    <core:Item key="Invoice" text="Invoice" />
                                    <core:Item key="InvoiceAmount" text="Invoice Amount" />
                                    <core:Item key="DeductionAmount" text="Deduction Amount" />
                                    <core:Item key="DifferenceReason" text="Difference Reason" />
                                    <core:Item key="InvoiceCurrency" text="Invoice Currency" />
                                    </items>
                                    </Select> -->

                                            <!-- MAPPING RULE — original Select binding -->
                                            <!-- <Select selectedKey="{mappingRule}" width="100%">
                                    <items>
                                    <core:Item key="" text="— None —" />
                                    <core:Item key="Source" text="Source" />
                                    <core:Item key="Rule base" text="Rule base" />
                                    <core:Item key="Table" text="Table" />
                                    <core:Item key="Formulae" text="Formulae" />
                                    <core:Item key="Derived" text="Derived" />
                                    <core:Item key="Default" text="Default" />
                                    </items>
                                    </Select> -->

                                            <!-- ACTIONS -->
                                            <!-- <HBox
                                                justifyContent="Center"
                                                width="100%"
                                            >
                                                <Button
                                                    icon="sap-icon://delete"
                                                    type="Reject"
                                                    press=".onDeleteMapping"
                                                />
                                            </HBox> -->
                                            <!-- ACTIONS -->
                                            <HBox
                                                justifyContent="Center"
                                                alignItems="Center"
                                                width="48px"
                                                shrinkable="false">
                                                <Button
                                                    icon="sap-icon://delete"
                                                    type="Reject"
                                                    press=".onDeleteMapping" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </ScrollContainer>
                    </content>
                </Panel>
            </VBox>
        </content>

        <footer>
            <OverflowToolbar>
                <Button
                    text="Back"
                    icon="sap-icon://back"
                    press=".onNavBack"
                />
                <ToolbarSpacer />
                <Button
                    text="Preview API Payload"
                    icon="sap-icon://developer-settings"
                    press=".onPreviewAPIPayload"
                />
                <Button
                    text="Validate Mapping"
                    icon="sap-icon://accept"
                    press=".onValidateMapping"
                />
                <!-- <Button icon="sap-icon://save" type="Emphasized" tooltip="Save Changes"
                press=".onSaveChanges" /> -->
                <Button
                    icon="sap-icon://save"
                    type="Emphasized"
                    tooltip="Save Changes"
                    press=".onSaveChanges"
                    visible="{= !${authModel>/isStandardTemplate} || ${authModel>/isAdmin} }"
                />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>